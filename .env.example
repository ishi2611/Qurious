# Copy to .env (next to this file) and fill in. Never commit .env.
# Read by the FastAPI backend. The web app has its own web/.env.example.
# Each group is needed from the milestone in parentheses; M0 runs with all of these empty.

# LLM (M6). Groq is primary, Gemini the fallback. Model names were current on 2026-09-24;
# check each provider's docs before changing them. With no keys, the tutor still works
# (retrieval-only answers, hand-written hooks).
GROQ_API_KEY=
GEMINI_API_KEY=
# Primary = a Groq model id; fallback = a Gemini model id.
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: run circuits on real IBM hardware (M9). An API key from quantum.cloud.ibm.com.
# The free plan has only a few minutes of hardware time per month.
IBM_QUANTUM_TOKEN=
# Optional IBM Cloud instance CRN (leave empty to let IBM choose).
IBM_QUANTUM_INSTANCE=

# Supabase: progress and study data (M8). Without these, the API stores study data in a local
# SQLite file (api/.data/qurious.db) and accounts are disabled.
# Legacy anon/service_role keys are deprecated by Supabase at the end of 2026; use the new
# publishable (sb_publishable_…) and secret (sb_secret_…) keys in these same variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Study mode: enrolment stays closed until this is true. Only switch it on once the consent
# form and pre/post-test are reviewed (and ethics approval is in place, if required).
STUDY_ENABLED=false

# Study export: researchers send "Authorization: Bearer <token>" to download CSVs.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STUDY_ADMIN_TOKEN=

# Feature flags
# v2: let learners type their own question (also set NEXT_PUBLIC_FEATURE_FREE_TEXT in web/).
FEATURE_FREE_TEXT=false
