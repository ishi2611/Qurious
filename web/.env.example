# Copy to .env.local to override. Where the FastAPI backend runs:
NEXT_PUBLIC_API_URL=http://localhost:8000

# v2: show the free-text question box (the API needs FEATURE_FREE_TEXT=true too).
NEXT_PUBLIC_FEATURE_FREE_TEXT=false

# Study mode: shows /study (the API needs STUDY_ENABLED=true too).
NEXT_PUBLIC_STUDY_MODE=false
# Shown on the consent form: who runs the study and how to contact them.
NEXT_PUBLIC_STUDY_CONTACT=

# Optional accounts (sync progress across devices). Leave empty for local-only progress.
NEXT_PUBLIC_SUPABASE_URL=
# A publishable key (sb_publishable_…); legacy anon keys are deprecated at the end of 2026.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
